# ---- Public (safe for browser) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Server-only (never NEXT_PUBLIC_) ----
SUPABASE_SERVICE_ROLE_KEY=
# Qloo hackathon key: https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide#getting-your-api-key
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_DAILY_CALL_CAP=400
QLOO_CACHE_TTL_SECONDS=86400
# Optional: LLM narrative (deterministic core works without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Demo abuse guards
DEMO_RATE_LIMIT_PER_10MIN=20
SERPAPI_API_KEY=
CRON_SECRET=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_KEY=
